{
  "name": "kinex-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter hub-api",
    "dev:web": "turbo dev --filter hub-web",
    "dev:pms-api": "turbo dev --filter pms-api",
    "dev:pms-web": "turbo dev --filter pms-web",
    "dev:mac": "./scripts/dev-mac.sh",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "bun --filter @kinex/database db:generate",
    "db:push": "bun --filter @kinex/database db:push",
    "db:generate-migration": "bun --filter @kinex/database db:generate-migration",
    "db:seed": "bun --filter @kinex/database db:seed",
    "db:studio": "bun --filter @kinex/database prisma studio",
    "db:reset": "bun --filter @kinex/database prisma migrate reset",
    "pms-db:push": "cd apps/pms-api && bun run db:push",
    "pms-db:seed": "cd apps/pms-api && bun run db:seed",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.1.2",
    "prettier": "^3.3.3"
  },
  "packageManager": "bun@1.1.29"
}
